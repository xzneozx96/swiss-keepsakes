# Optional overrides for the spikes. Copy to spikes/.env (gitignored). Missing keys never fail a spike:
# it prints "SKIP <spike>: missing KEY1, KEY2" and exits 0. Never paste live-mode keys.
#
# Neon keys are NOT listed here. They come from `neon deploy` into api/.env.local (the only Neon env file the
# spikes read), with Neon's official names: DATABASE_URL (pooled), DATABASE_URL_UNPOOLED (direct), NEON_BRANCH,
# NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3,
# AWS_REGION. spikes/lib/env.ts loads api/.env.local first, then this file overrides it.
#
# api/.env.local points at a long-lived branch (development). SP2 and SP3 never write there: their Neon part
# creates its own throwaway branch from NEON_BRANCH (`neon branches create --expires-at`, project id from
# api/.neon), runs on it and deletes it. They refuse when NEON_BRANCH is production, staging or main.

# ---------------------------------------------------------------- Stripe (SP1, SP4)
# Sandbox only (stripe-best-practices: use a sandbox, not the shared test mode; `stripe sandbox create` works with no account).
# Dashboard > Developers > API keys > Create restricted key (rk_test_...). Least privilege for SP1 + SP4:
#   PaymentIntents: Write, PaymentMethodConfigurations: Read, Account: Read. Nothing else.
# Never use an sk_ secret key (the scripts refuse anything that is not rk_test_).
STRIPE_SECRET_KEY=
# Dashboard > Developers > API keys > Publishable key (pk_test_...). Only the manual SP4 TWINT page needs it.
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- Fly.io (SP3 remote, SP7)
# SP3 latency is only a valid result from a Fly fra machine. Fly sets FLY_REGION itself: do not paste it here.
# Locally it is empty and SP3 runs as a laptop run (correctness valid, latency not).
FLY_REGION=
# SP7. App-scoped deploy token for the staging app only: `fly tokens create deploy -a <staging-app>`.
FLY_API_TOKEN=
# SP7. Name of an empty staging Fly app in region fra (`fly apps create`).
FLY_APP_STAGING=
# SP7 only, for later. A separate Postgres role that may run DDL (the Fly release command runs Drizzle migrations
# with it). It is not in .env.local: the app itself must not hold this role. Direct connection string.
DATABASE_URL_DDL=

# ---------------------------------------------------------------- Neon, optional spike settings
# SP5 buckets declared in neon.ts. Defaults: uploads (private) and media (public_read).
SP5_BUCKET_PRIVATE=
SP5_BUCKET_PUBLIC=
# SP6. Without SP6_JWT the spike signs up a throwaway email+password user, gets a JWT and deletes the user with
# `neon neon-auth user delete` (project id from api/.neon, or NEON_PROJECT_ID below to override).
NEON_PROJECT_ID=
# SP6. A JWT copied from the SPA (`(await authClient.token()).data.token`, valid 15 minutes) skips the sign-up.
SP6_JWT=
# SP6. A second JWT for the same user fetched 16+ minutes later, to prove renewal.
SP6_JWT_LATER=
