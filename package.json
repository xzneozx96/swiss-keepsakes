{
  "name": "swiss-keepsakes",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "e2e": "pnpm --dir front-end build && pnpm --dir e2e test"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
