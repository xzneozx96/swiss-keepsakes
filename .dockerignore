# An allow-list: the API image needs only the API, the workspace packages it imports and the lockfile.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.pnpmfile.cjs
!api/
!packages/api-contract/
!packages/i18n/

# Never send installs, build output, tests or local env files, even from the allowed folders.
**/node_modules
**/dist
**/.env*
**/*.local
api/test
