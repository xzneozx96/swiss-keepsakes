{
  "extends": "./tsconfig.json",
  // Only src/identity, which the API imports. The other folders use extensionless imports that Node cannot load.
  "compilerOptions": {
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist"
  },
  "include": ["src/identity"]
}
