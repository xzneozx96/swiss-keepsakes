{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    // The API runs src/identity compiled, and Node 22.18 and later would run this source if the sk-compiled flag were missing.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
