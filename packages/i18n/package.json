{
  "name": "@sk/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./en": {
      "sk-compiled": "./dist/src/en.js",
      "default": "./src/en.ts"
    },
    "./de": {
      "sk-compiled": "./dist/src/de.js",
      "default": "./src/de.ts"
    },
    "./key-drift": {
      "sk-compiled": "./dist/src/key-drift.js",
      "default": "./src/key-drift.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
