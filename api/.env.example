# Copy to api/.env.local, which git ignores. `pnpm dev` reads it, and variables already set in the shell win.
# `neon env pull` writes the same file with the Neon development branch's variables.

# api, worker or all. `all` runs both in one process, as production machines do (D1).
ROLE=all
# The address the API listens on. The default, 0.0.0.0, is for containers. Locally, keep it on this machine.
HOST=127.0.0.1
# 0 picks a free port.
PORT=3000
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Postgres from docker-compose.yml. It trusts local connections, so there is no password.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/swiss_keepsakes
