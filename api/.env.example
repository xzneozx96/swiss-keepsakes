# Copy to api/.env.local, which git ignores. `pnpm dev` at the repo root reads it and starts the API with the SPA, and variables already set in the shell win.
# `neon env pull` writes the same file with the Neon development branch's variables.

# api, worker or all. `all` runs both in one process, as production machines do (D1).
ROLE=all
# The address the API listens on. The default, 0.0.0.0, is for containers. Locally, keep it on this machine.
HOST=127.0.0.1
# 0 picks a free port.
PORT=5002
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Postgres. `neon env pull` writes the Neon `development` branch's URLs here, and the integration tests use them
# (docs/development-rules/shared/testing.md). docker-compose.yml is optional, for offline work: it trusts local
# connections, so the URLs below have no password.
# Requests use DATABASE_URL. pg-boss and migrations use DATABASE_URL_UNPOOLED, which on Neon skips the pooler.
# Locally both point at the same server. Run `pnpm --filter @sk/api db:migrate` once before `pnpm dev`.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/swiss_keepsakes
DATABASE_URL_UNPOOLED=postgres://postgres@127.0.0.1:5433/swiss_keepsakes
# Mail over SMTP (D12). Locally and on staging, the test SMTP account. Set all six or none. A partial setting
# stops startup. With none, the service starts, logs a warning, and every mail fails and retries until they
# are set (docs/ops/mail.md).
SMTP_HOST=
SMTP_PORT=
# true for TLS from the start (port 465). false for STARTTLS (port 587), which the service then requires.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# The sender address. Gmail accepts only the signed-in account.
SMTP_FROM=
# Better Auth (D8). The service refuses to start without BETTER_AUTH_URL and BETTER_AUTH_SECRET.
# The origin the browser sees. Locally that is the Vite dev server, which proxies /api to this API. The session
# cookie, the one trusted origin and the Google redirect URI (<origin>/api/auth/callback/google) come from it.
BETTER_AUTH_URL=http://localhost:3002
# At least 32 characters, never committed. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Our own Google OAuth app. Set both or neither: without them Google sign-in is not offered and the emailed
# code still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The origin of the SPA, which the Owner's invitation link opens (E2.3). Locally that is the Vite dev server, as
# BETTER_AUTH_URL is. Required with NODE_ENV=production, where it must be https. Only its origin is used.
APP_URL=http://localhost:3002
