# Copy to api/.env.local, which git ignores. `pnpm dev` reads it, and variables already set in the shell win.
# `neon env pull` writes the same file with the Neon development branch's variables.

# api, worker or all. `all` runs both in one process, as production machines do (D1).
ROLE=all
# The address the API listens on. The default, 0.0.0.0, is for containers. Locally, keep it on this machine.
HOST=127.0.0.1
# 0 picks a free port.
PORT=3000
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Postgres from docker-compose.yml. It trusts local connections, so there is no password.
# Requests use DATABASE_URL. pg-boss and migrations use DATABASE_URL_UNPOOLED, which on Neon skips the pooler.
# Locally both point at the same server. Run `pnpm --filter @sk/api db:migrate` once before `pnpm dev`.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/swiss_keepsakes
DATABASE_URL_UNPOOLED=postgres://postgres@127.0.0.1:5433/swiss_keepsakes
# Mail over SMTP (D12). Locally and on staging, the test SMTP account. Set all six or none. A partial setting
# stops startup. With none, the service starts, logs a warning, and every mail fails and retries until they
# are set (docs/ops/mail.md).
SMTP_HOST=
SMTP_PORT=
# true for TLS from the start (port 465). false for STARTTLS (port 587), which the service then requires.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# The sender address. Gmail accepts only the signed-in account.
SMTP_FROM=
