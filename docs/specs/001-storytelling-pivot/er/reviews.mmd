    identity_guest_profiles ||..o{ reviews_place_reviews : "author_guest_id"
    content_story_groups ||..o{ reviews_story_comments : "story_group_id"
    identity_guest_profiles |o..o{ reviews_story_comments : "author_guest_id"
    identity_user |o..o{ reviews_story_comments : "staff_user_id"
